# BULWARK Coverage API (packages/api) — Bun-native HTTP server.
# Default: 8787
BULWARK_API_PORT=8787

# BULWARK dashboards (packages/dashboard) — owner/capital/record surfaces.
# Default: 3000
BULWARK_DASH_PORT=3000

# Coverage API base URL proxied by the dashboard server (packages/dashboard/serve.ts).
# Default: http://localhost:8787
BULWARK_API_URL=http://localhost:8787

# ERC-8004 orchestrator (packages/api/src/erc8004-orchestrator.ts).
# Arc testnet gas is native USDC; fund each role via faucet.circle.com.
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_OPS_KEY=0x
ARC_WATCHER_KEY=0x
ARC_REPUTATION_KEY=0x
ARC_AGENT_ID=0
# Smoke-test keys (packages/api/scripts/arc-smoke.ts) — separate disposable trio.
ARC_SMOKE_OPS_KEY=0x
ARC_SMOKE_WATCHER_KEY=0x
ARC_SMOKE_REPUTATION_KEY=0x
