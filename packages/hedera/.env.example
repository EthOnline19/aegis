# REPAYD x402 Coverage & Risk API — environment
# Copy to the repo-root .env (or export) and fill the two testnet accounts.

# --- Hedera testnet accounts (portal.hedera.com → faucet) ---
# Payer: the agent account that signs the x402 TransferTransaction.
HEDERA_OPERATOR_ID=0.0.000000
HEDERA_OPERATOR_KEY=0x…ecdsa-hex…
# Service: x402 payTo (receives payments). Its key also signs live HCS memos.
HEDERA_SERVICE_ID=0.0.10484593
HEDERA_SERVICE_KEY=0x…ecdsa-hex…

# --- Network ---
HEDERA_NETWORK=testnet
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
REPAYD_X402_PORT=4601
# Payer agent → where the service listens:
REPAYD_SERVICE_URL=http://localhost:4601

# --- Optional ---
# Reuse an existing HCS audit topic (else auto-created when live):
HEDERA_RECEIPT_TOPIC_ID=0.0.10493275
# Read-only ERC-8004 ownerOf validation against the Arc testnet registry:
ARC_RPC_URL=https://rpc.testnet.arc.io
# Recurring-premium schedule amount (HBAR per draw):
REPAYD_PREMIUM_HBAR=0.001
